<Window x:Class="DominoBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DominoBridge.App.Converters"
        Title="Domino Ax150i Excel Printer (EDC TCP)" Width="1200" Height="860" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <conv:HexByteConverter x:Key="Hex"/>
        <conv:DelimiterConverter x:Key="Delim"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: configuration + controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Printer (EDC TCP)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.Printer.IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox Grid.Column="3" Text="{Binding Settings.Printer.Port, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/>
                            <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                            <Button Content="Send Test Data" Command="{Binding SendTestCommand}"/>
                        </WrapPanel>
                        <Expander Header="Advanced settings" Margin="0,8,0,0">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,2"/></Style>
                                    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2"/></Style>
                                    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2"/></Style>
                                </Grid.Resources>
                                <TextBlock Text="Encoding"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding EncodingNames}" SelectedItem="{Binding Settings.Printer.Encoding}"/>
                                <TextBlock Grid.Row="1" Text="Start marker (hex)"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Printer.StartMarker, Converter={StaticResource Hex}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Text="End marker (hex)"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Printer.EndMarker, Converter={StaticResource Hex}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="3" Text="Delimiter"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding DelimiterChoices}"
                                          Text="{Binding Settings.Printer.Delimiter, Converter={StaticResource Delim}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="4" Text="ACK byte (hex)"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Printer.AckByte, Converter={StaticResource Hex}, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="5" Text="NAK byte (hex) *"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.Printer.NakByte, Converter={StaticResource Hex}, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="UNKNOWN / REQUIRES DEVICE TEST: the NAK byte is not specified; 0x15 is only a placeholder."/>
                                <TextBlock Grid.Row="6" Text="Connect timeout (ms)"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Printer.ConnectTimeoutMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="7" Text="ACK timeout (ms)"/>
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.Printer.AckTimeoutMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="8" Text="Batch size"/>
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.Queue.BatchSize, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="9" Text="Printer max queue size"/>
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.Queue.MaxQueueSize, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="10" Text="Reconnect interval (ms, 0=off)"/>
                                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.Queue.ReconnectIntervalMs, UpdateSourceTrigger=LostFocus}"/>
                                <StackPanel Grid.Row="11" Grid.Column="1">
                                    <CheckBox Content="Debug: log TX/RX as hex" Margin="0,4" IsChecked="{Binding Settings.DebugHex}"/>
                                    <CheckBox Content="Auto buffer refill (no manual clicks)" Margin="0,2" IsChecked="{Binding Settings.Queue.AutoRefill}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Excel">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Margin="0"/>
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Load" Command="{Binding LoadCommand}" Margin="0" MinWidth="60"/>
                            <TextBlock Text="{Binding ExcelInfo}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Mapping: Excel column → EDC index (empty = not sent)">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="190" MinHeight="70" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Excel column" Binding="{Binding Header}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="First value" Binding="{Binding Sample}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="EDC index" Binding="{Binding EdcIndexText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="Delimiter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox IsEditable="True" Width="70" ItemsSource="{Binding DelimiterChoices}"
                                      Text="{Binding Settings.Printer.Delimiter, Converter={StaticResource Delim}, UpdateSourceTrigger=LostFocus}"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Preview" Command="{Binding PreviewCommand}" Margin="0"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Send">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Start / Continue" Command="{Binding StartCommand}" FontWeight="Bold"/>
                            <Button Content="Pause" Command="{Binding PauseCommand}"/>
                            <Button Content="Resume" Command="{Binding ResumeCommand}"/>
                            <Button Content="Stop" Command="{Binding StopCommand}"/>
                        </WrapPanel>
                        <Button Content="Printer buffer empty (manual mode only)" Command="{Binding BufferDrainedCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                ToolTip="Confirm that the printer has consumed everything sent so far, so the next batch can be sent."/>
                        <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Selected row decision"/>
                        <WrapPanel>
                            <Button Content="Retry (NAK row)" Command="{Binding RetryCommand}"/>
                            <Button Content="Mark accepted" Command="{Binding MarkAcceptedCommand}"/>
                            <Button Content="Mark NOT received" Command="{Binding MarkNotReceivedCommand}"/>
                            <Button Content="Skip row" Command="{Binding SkipCommand}"/>
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="Gray"
                                   Text="Stop / Pause only stop sending; they never clear the printer buffer. Clearing the buffer must be done on the printer."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: status, rows, preview, log -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#888" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="#F3F3F3">
                <StackPanel>
                    <TextBlock><Run Text="Status: " FontWeight="Bold"/><Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{Binding SchedulerText, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding QueueText}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding CountsText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      EnableRowVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Accepted"><Setter Property="Background" Value="#DFF5DF"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Sending"><Setter Property="Background" Value="#FFF3C4"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Rejected"><Setter Property="Background" Value="#F8D0D0"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#F8D0D0"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Unknown"><Setter Property="Background" Value="#FFD9A8"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Skipped"><Setter Property="Background" Value="#E6E6E6"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55"/>
                    <DataGridTextColumn Header="Excel row" Binding="{Binding ExcelRowId}" Width="75"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Payload" Binding="{Binding DisplayPayload}" Width="*"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Preview" FontWeight="Bold" Margin="0,8,0,2"/>
            <TextBox Grid.Row="3" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Height="150"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" Margin="0,0,0,2"/>
                <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" x:Name="LogList"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
