<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DominoBridge.App</RootNamespace>
    <AssemblyName>DominoAx150iBridge</AssemblyName>
    <ApplicationTitle>Domino Ax150i Excel Printer Bridge</ApplicationTitle>
    <Version>1.0.0</Version>
    <!-- one self-contained exe: no .NET install required on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DominoBridge.Core/DominoBridge.Core.csproj" />
  </ItemGroup>
</Project>
